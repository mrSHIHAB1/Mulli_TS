# App
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Auth
BCRYPT_SALT_ROUND=12
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES=7d
EXPRESS_SESSION_SECRET=your_express_session_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_HOST_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
APP_PASS=your_app_password

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@yourdomain.com

# Google
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/google-service-account.json

# Apple Sign-In / IAP
APPLE_CLIENT_ID=com.yourapp.bundle
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/apple/callback
APPLE_SHARED_SECRET=your_apple_shared_secret

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
